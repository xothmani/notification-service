<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Security Vulnerability Report</title>
<style>
  *{box-sizing:border-box;margin:0;padding:0}
  body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:#f0f2f5;color:#333}
  .header{background:#0f172a;color:#fff;padding:28px 40px}
  .header h1{font-size:22px;font-weight:700;letter-spacing:.3px}
  .header p{color:#94a3b8;margin-top:6px;font-size:13px}
  .container{max-width:1400px;margin:28px auto;padding:0 28px}
  .summary{display:flex;gap:14px;margin-bottom:24px}
  .card{flex:1;background:#fff;border-radius:10px;padding:20px 16px;box-shadow:0 1px 4px rgba(0,0,0,.08);text-align:center;border-top:4px solid}
  .card.critical{border-color:#dc2626}.card.high{border-color:#ea580c}
  .card.medium{border-color:#d97706}.card.low{border-color:#65a30d}
  .card.negligible{border-color:#6b7280}.card.unknown{border-color:#a855f7}
  .card .count{font-size:34px;font-weight:800}
  .card.critical .count{color:#dc2626}.card.high .count{color:#ea580c}
  .card.medium .count{color:#d97706}.card.low .count{color:#65a30d}
  .card.negligible .count{color:#6b7280}.card.unknown .count{color:#a855f7}
  .card .label{font-size:11px;color:#888;margin-top:5px;text-transform:uppercase;letter-spacing:.6px;font-weight:600}
  .toolbar{display:flex;gap:10px;margin-bottom:14px;align-items:center;flex-wrap:wrap}
  .search{flex:1;min-width:200px;padding:9px 14px;border:1px solid #e2e8f0;border-radius:7px;font-size:13px;outline:none}
  .search:focus{border-color:#3b82f6;box-shadow:0 0 0 3px rgba(59,130,246,.1)}
  .filter-btn{padding:7px 16px;border:1px solid #e2e8f0;border-radius:7px;background:#fff;cursor:pointer;font-size:12px;font-weight:600;color:#555;transition:all .15s}
  .filter-btn:hover{background:#f8fafc}
  .filter-btn.active{background:#0f172a;color:#fff;border-color:#0f172a}
  .total-label{font-size:13px;color:#64748b;margin-left:auto}
  table{width:100%;border-collapse:collapse;background:#fff;border-radius:10px;overflow:hidden;box-shadow:0 1px 4px rgba(0,0,0,.08)}
  thead tr{background:#0f172a}
  th{padding:12px 16px;text-align:left;font-size:12px;font-weight:600;color:#94a3b8;text-transform:uppercase;letter-spacing:.5px}
  td{padding:11px 16px;font-size:13px;border-bottom:1px solid #f1f5f9;vertical-align:middle}
  tr.data-row:last-child td{border-bottom:none}
  tr.data-row:hover td{background:#f8fafc}
  .badge{display:inline-block;padding:3px 10px;border-radius:20px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.4px}
  .badge.critical{background:#fee2e2;color:#dc2626}
  .badge.high{background:#ffedd5;color:#ea580c}
  .badge.medium{background:#fef3c7;color:#b45309}
  .badge.low{background:#ecfccb;color:#4d7c0f}
  .badge.negligible{background:#f3f4f6;color:#4b5563}
  .badge.unknown{background:#f3e8ff;color:#7e22ce}
  .pkg-name{font-weight:600;color:#1e293b}
  .pkg-version{color:#64748b;font-family:monospace;font-size:12px}
  .fix-ver{color:#16a34a;font-size:12px;font-weight:500}
  .no-fix{color:#94a3b8;font-size:12px}
  .vuln-link{color:#2563eb;text-decoration:none;font-weight:500}
  .vuln-link:hover{text-decoration:underline}
  .type-badge{background:#e0e7ff;color:#3730a3;padding:2px 8px;border-radius:4px;font-size:11px;font-weight:500}
  .hidden{display:none!important}
  .no-results{text-align:center;padding:40px;color:#94a3b8;font-size:14px}
</style>
</head>
<body>

<div class="header">
  <h1>Security Vulnerability Report</h1>
  <p>Generated by Syft + Grype &nbsp;|&nbsp; Scan date: <span id="scan-date"></span></p>
</div>

<div class="container">

  <div class="summary">
    <div class="card critical"><div class="count" id="cnt-critical">0</div><div class="label">Critical</div></div>
    <div class="card high"><div class="count" id="cnt-high">0</div><div class="label">High</div></div>
    <div class="card medium"><div class="count" id="cnt-medium">0</div><div class="label">Medium</div></div>
    <div class="card low"><div class="count" id="cnt-low">0</div><div class="label">Low</div></div>
    <div class="card negligible"><div class="count" id="cnt-negligible">0</div><div class="label">Negligible</div></div>
    <div class="card unknown"><div class="count" id="cnt-unknown">0</div><div class="label">Unknown</div></div>
  </div>

  <div class="toolbar">
    <input class="search" id="search" type="text" placeholder="Search package, CVE ID, type..." oninput="applyFilters()">
    <button class="filter-btn active" onclick="setSeverity('all',this)">All</button>
    <button class="filter-btn" onclick="setSeverity('critical',this)">Critical</button>
    <button class="filter-btn" onclick="setSeverity('high',this)">High</button>
    <button class="filter-btn" onclick="setSeverity('medium',this)">Medium</button>
    <button class="filter-btn" onclick="setSeverity('low',this)">Low</button>
    <button class="filter-btn" onclick="setSeverity('negligible',this)">Negligible</button>
    <span class="total-label" id="visible-count"></span>
  </div>

  <table id="vuln-table">
    <thead>
      <tr>
        <th>Package</th>
        <th>Version</th>
        <th>Type</th>
        <th>Vulnerability ID</th>
        <th>Severity</th>
        <th>Fixed In</th>
      </tr>
    </thead>
    <tbody>
      {{range .Matches}}
      <tr class="data-row" data-severity="{{.Vulnerability.Severity | lower}}">
        <td><span class="pkg-name">{{.Artifact.Name}}</span></td>
        <td><span class="pkg-version">{{.Artifact.Version}}</span></td>
        <td><span class="type-badge">{{.Artifact.Type}}</span></td>
        <td>
          {{if .Vulnerability.URLs}}
          <a class="vuln-link" href="{{index .Vulnerability.URLs 0}}" target="_blank">{{.Vulnerability.ID}}</a>
          {{else}}
          <span>{{.Vulnerability.ID}}</span>
          {{end}}
        </td>
        <td><span class="badge {{.Vulnerability.Severity | lower}}">{{.Vulnerability.Severity}}</span></td>
        <td>
          {{if .Vulnerability.Fix.Versions}}
          <span class="fix-ver">{{join .Vulnerability.Fix.Versions ", "}}</span>
          {{else}}
          <span class="no-fix">No fix available</span>
          {{end}}
        </td>
      </tr>
      {{end}}
    </tbody>
  </table>

  <div class="no-results hidden" id="no-results">No vulnerabilities match your filter.</div>

</div>

<script>
  document.getElementById('scan-date').textContent = new Date().toLocaleString();

  var currentSeverity = 'all';

  function countSeverities() {
    var rows = document.querySelectorAll('.data-row');
    var c = {critical:0, high:0, medium:0, low:0, negligible:0, unknown:0};
    rows.forEach(function(r){ var s = r.dataset.severity; if(c[s]!==undefined) c[s]++; });
    Object.keys(c).forEach(function(k){ document.getElementById('cnt-'+k).textContent = c[k]; });
  }

  function applyFilters() {
    var search = document.getElementById('search').value.toLowerCase();
    var rows = document.querySelectorAll('.data-row');
    var visible = 0;
    rows.forEach(function(r) {
      var text = r.textContent.toLowerCase();
      var sev  = r.dataset.severity;
      var show = text.includes(search) && (currentSeverity === 'all' || sev === currentSeverity);
      r.classList.toggle('hidden', !show);
      if(show) visible++;
    });
    document.getElementById('visible-count').textContent = visible + ' result' + (visible !== 1 ? 's' : '');
    document.getElementById('no-results').classList.toggle('hidden', visible > 0);
  }

  function setSeverity(sev, btn) {
    currentSeverity = sev;
    document.querySelectorAll('.filter-btn').forEach(function(b){ b.classList.remove('active'); });
    btn.classList.add('active');
    applyFilters();
  }

  countSeverities();
  applyFilters();
</script>
</body>
</html>
